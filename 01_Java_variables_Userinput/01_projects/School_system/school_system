import java.util.Scanner;
public class main{
    public static void main(String[]args){
        String full_name;
        String id_number;
        int age;
        String gender;
        int Level;
        int phone_Number;
        Scanner input = new Scanner(System.in);

        System.out.print("Enter your Full Name: ");
        full_name = input.nextLine();

        System.out.print("Enter your Student ID: ");
        id_number = input.nextLine();

        System.out.print("Enter your age: ");
        age = input.nextInt();

        System.out.print("Enter Gender M/F: ");
        gender = input.next();

        System.out.print("Enter which Level: ");
        Level = input.nextInt();

        System.out.print("Enter phone Number: ");
        phone_Number = input.nextInt();

        System.out.println("================= STUDENT REGISTRATION =================");

        System.out.println("Hello,"+ full_name);
        System.out.println("You are "+ age);
        System.out.println("You are also a " + gender);
        System.out.println("You are currently in Level: " + Level);
        System.out.println("Your Phone Number is" + phone_Number);

        System.out.println("===================================");
    }
}
